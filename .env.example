# =============================================================================
# DevPulse — environment configuration
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed. Every value below is
# read server-side only (API routes / scripts) — no credential is ever exposed
# to the browser. The single exception is NEXT_PUBLIC_APP_URL, which is a
# non-secret public URL by design.
# =============================================================================

# --- HydraDB -----------------------------------------------------------------
# Get your API key at https://app.hydradb.com
HYDRA_DB_API_KEY=your_hydradb_api_key
# The database (top-level isolated workspace) DevPulse writes everything into.
HYDRA_DB_DATABASE=devpulse_team
HYDRA_DB_API_VERSION=2

# --- Fireworks AI ------------------------------------------------------------
# Get your API key at https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=your_fireworks_api_key
# Model IDs on Fireworks change often. Run `npm run list-models` to print the
# serverless models your account can actually call, then paste one here.
# Must support tool calling + JSON mode for best results.
FIREWORKS_MODEL_ID=accounts/fireworks/models/kimi-k2-instruct-0905

# --- GitHub connector --------------------------------------------------------
# Personal access token with `repo` + `read:org` scope.
# https://github.com/settings/tokens
GITHUB_CONNECTOR_TOKEN=your_github_personal_access_token
# Org name or username — used as HydraDB's provider_account_scope.
GITHUB_ORG_OR_USER=your_github_org_or_username

# --- Slack connector ---------------------------------------------------------
# User or bot token with channels:history, channels:read, users:read.
# https://api.slack.com/apps
SLACK_CONNECTOR_TOKEN=xoxp-your-slack-user-or-bot-token
# Workspace ID beginning with T — used as provider_account_scope.
SLACK_WORKSPACE_ID=your_slack_workspace_id_starting_with_T

# --- Linear connector --------------------------------------------------------
# Personal API key from Linear > Settings > API.
LINEAR_CONNECTOR_TOKEN=your_linear_api_key
LINEAR_WORKSPACE_NAME=your_linear_workspace_name

# --- Notion connector --------------------------------------------------------
# Internal integration token from https://www.notion.so/my-integrations
# Remember to share the pages/databases with the integration.
NOTION_CONNECTOR_TOKEN=your_notion_integration_token
NOTION_WORKSPACE_NAME=your_notion_workspace_name

# --- Gmail connector ---------------------------------------------------------
# OAuth access token with gmail.readonly scope.
GMAIL_CONNECTOR_TOKEN=your_gmail_oauth_token
# Gmail has no workspace-level scope, so the account email is carried in
# additional_metadata.account_email instead of provider_account_scope.
GMAIL_ACCOUNT_EMAIL=your_email@gmail.com

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
