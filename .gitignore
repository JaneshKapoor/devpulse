# secrets — never commit these.
# Note the bare `.env` line: Next.js' generated .gitignore only covers
# `.env*.local`, which would leave a plain `.env` file exposed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# local data stores (metrics logging)
data/*.db
data/*.sqlite
data/*.sqlite3
data/metrics.json
*.db-journal

# vercel
.vercel

# editors
.idea/
.vscode/
*.swp
